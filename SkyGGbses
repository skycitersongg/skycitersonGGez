local ADMIN_LIST = { "NickAdmin1" } 
local BLACKLIST = { "Zbanowany1" } 

_G.DynamicRanks = _G.DynamicRanks or {}

local function getSystemRole(player)
    if player.Name == WYSTAWCA_RANG then return "Właściciel" end
    for _, name in ipairs(EARLY_ACCESS_LIST) do if player.Name == name then return "Współpraca" end end
    for _, name in ipairs(ADMIN_LIST) do if player.Name == name then return "Admin" end end
    if _G.DynamicRanks[player.Name] then return _G.DynamicRanks[player.Name] end
    return "Użytkownik"
end

