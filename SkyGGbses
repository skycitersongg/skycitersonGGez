local function createControlBtn(text, xPos, color, parent)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 25, 0, 25)
    btn.Position = UDim2.new(0, xPos, 0, 10)
    btn.BackgroundColor3 = Color3.fromRGB(20, 35, 22)
