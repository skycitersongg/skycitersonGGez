bCloseChat.TextSize = 11
bCloseChat.Text = "X"
Instance.new("UICorner", bCloseChat).CornerRadius = UDim.new(0, 5)
bCloseChat.MouseButton1Click:Connect(function() chatFrame.Visible = false end)

local chatLog = Instance.new("ScrollingFrame", chatFrame)
chatLog.Size = UDim2.new(1, -20, 0, 180)
chatLog.Position = UDim2.new(0, 10, 0, 60)
chatLog.BackgroundColor3 = Color3.fromRGB(8, 14, 9)
chatLog.ScrollBarThickness = 2
chatLog.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 120)
chatLog.CanvasSize = UDim2.new(0, 0, 0, 0)
chatLog.AutomaticCanvasSize = Enum.AutomaticSize.Y
Instance.new("UICorner", chatLog).CornerRadius = UDim.new(0, 6)
local cLayout = Instance.new("UIListLayout", chatLog) cLayout.Padding = UDim.new(0, 4)

local chatInput = Instance.new("TextBox", chatFrame)
chatInput.Size = UDim2.new(1, -20, 0, 32)
chatInput.Position = UDim2.new(0, 10, 0, 253)
chatInput.BackgroundColor3 = Color3.fromRGB(20, 40, 24)
chatInput.TextColor3 = Color3.fromRGB(255, 255, 255)
chatInput.Font = Enum.Font.Gotham
chatInput.TextSize = 12
chatInput.PlaceholderText = "Wpisz tekst i kliknij Enter..."
chatInput.Text = ""
Instance.new("UICorner", chatInput).CornerRadius = UDim.new(0, 6)

bChat.MouseButton1Click:Connect(function() chatFrame.Visible = not chatFrame.Visible end)

local function addMsg(sender, msg)
    local l = Instance.new("TextLabel", chatLog)
    l.Size = UDim2.new(1, -10, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Gotham
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = true
    l.RichText = true
    if sender == "Demon0x0x1" then
        l.Text = "<font color='rgb(255,50,50)'><b>[WŁAŚCICIEL] " .. sender .. ":</b></font> " .. msg
    elseif sender == lp.Name then
        l.Text = "<font color='rgb(0,255,120)'><b>" .. sender .. ":</b></font> " .. msg
    else
        l.Text = "<font color='rgb(200,200,200)'><b>" .. sender .. ":</b></font> " .. msg
    end
    task.wait(0.05) chatLog.CanvasPosition = Vector2.new(0, chatLog.AbsoluteContentSize.Y)
end

chatInput.FocusLost:Connect(function(ep)
    if ep and chatInput.Text ~= "" then local t = chatInput.Text chatInput.Text = "" addMsg(lp.Name, t) end
end)

if isOwner then
    local bSpd = Instance.new("TextButton", frame)
    bSpd.Size = UDim2.new(0, 150, 0, 38)
    bSpd.Position = UDim2.new(0, 15, 0, 275)
    bSpd.BackgroundColor3 = Color3.fromRGB(50, 45, 15)
    bSpd.TextColor3 = Color3.fromRGB(255, 215, 0)
    bSpd.Text = "SPEED HACK"
    Instance.new("UICorner", bSpd).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", bSpd).Color = Color3.fromRGB(255, 215, 0)
    
    local spdA = false
    bSpd.MouseButton1Click:Connect(function()
        spdA = not spdA
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then lp.Character.Humanoid.WalkSpeed = spdA and 50 or 16 end
        bSpd.Text = spdA and "SPEED: 50" or "SPEED HACK"
    end)

    local bJmp = Instance.new("TextButton", frame)
    bJmp.Size = UDim2.new(0, 150, 0, 38)
    bJmp.Position = UDim2.new(0, 175, 0, 275)
    bJmp.BackgroundColor3 = Color3.fromRGB(50, 45, 15)
    bJmp.TextColor3 = Color3.fromRGB(255, 215, 0)
    bJmp.Text = "INF JUMP"
    Instance.new("UICorner", bJmp).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", bJmp).Color = Color3.fromRGB(255, 215, 0)
    
    local jmpA = false
    bJmp.MouseButton1Click:Connect(function() jmpA = not jmpA bJmp.Text = jmpA and "JUMP: ON" or "INF JUMP" end)
    UIS.JumpRequest:Connect(function()if jmpA and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) endend)pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {Title = "WŁAŚCICIEL", Text = "Witaj, Demon0x0x1!"}) end)end
